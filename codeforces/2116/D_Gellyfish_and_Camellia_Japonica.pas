program D_Gellyfish_and_Camellia_Japonica;
uses
    math;
const
    nn = 300 * 1000;
var
    ntc, tci, n, q, i, k, x, y, z: int32;
    a, b, c: array [1 .. nn] of int32;

begin
    readln(ntc);
    for tci := 1 to ntc do begin

        readln(n, q);

        for i := 1 to n do read(b[i]);
        readln;

        for k := 1 to q do begin
            readln(x, y, z);
        end;

    end;
end.
