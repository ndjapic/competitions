    # Ignore all files within the 'bin' directory
    bin/

    # Ignore all files within the 'build' directory
    build/

    # Compiled executables
    *.exe
    *.dll
    *.so
    *.dylib

    # Object files and archives
    *.o
    *.a

    # Compiled Python files
    *.pyc
    *.pyo
    __pycache__/

    # Java class files
    *.class

    # Image files
    *.jpg
    *.png
    *.gif

    # Video files
    *.mp4
    *.mov

    # Archive files
    *.zip
    *.tar.gz
